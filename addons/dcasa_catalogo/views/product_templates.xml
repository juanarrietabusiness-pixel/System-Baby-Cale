<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ficha: «Disponible», «Quedan pocas» o «Agotado» junto al precio, con la regla de Juan (nunca el número).
         Odoo vuelve a pedir la información al abrir la ficha y al cambiar de medida: disponibilidad.js la repinta, así
         que una ficha guardada en el borde también muestra la de ahora. Comprar o no comprar no cambia. -->
    <template id="producto_disponibilidad" inherit_id="website_sale.product" name="D'CASA: disponibilidad en la ficha">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_price')]" position="inside">
            <t t-set="dcasa_disponibilidad" t-value="product._dcasa_disponibilidad_ficha(product_variant)"/>
            <p class="o_dcasa_disponibilidad" t-att-data-estado="dcasa_disponibilidad['estado']" role="status">
                <span class="o_dcasa_disponibilidad_punto" aria-hidden="true"/>
                <span class="o_dcasa_disponibilidad_texto" t-out="dcasa_disponibilidad['texto']"/>
            </p>
        </xpath>
    </template>

    <!-- Tarjetas de la portada (v3, 2026-11-15): «Quedan pocas» o «Agotado» sobre la foto, con la misma regla y las mismas
         palabras que la ficha (nunca el número). «Disponible» no se pinta: es lo normal y llenaría la fila de etiquetas.
         Va después del nombre (el lector de pantalla dice primero qué es y después cómo está) y el CSS la sube a la foto. -->
    <template id="tarjeta_disponibilidad" inherit_id="website_dcasa.tarjeta_producto" name="D'CASA: disponibilidad en la tarjeta">
        <xpath expr="//h3[hasclass('o_dcasa_pcard_name')]" position="after">
            <t t-set="dcasa_disponibilidad" t-value="producto._dcasa_disponibilidad_ficha()"/>
            <p t-if="dcasa_disponibilidad['estado'] != 'disponible'" class="o_dcasa_pcard_estado"
               t-att-data-estado="dcasa_disponibilidad['estado']" t-out="dcasa_disponibilidad['texto']"/>
        </xpath>
    </template>

    <!-- Ficha: medidas (impresas en la foto del proveedor), presentación de cada talla (el texto de la lista del
         dueño: unidades y rango de peso) y precio en combo, cada uno con su etiqueta y separado del precio para que
         nadie los confunda. -->
    <template id="producto_medidas_y_combo" inherit_id="website_sale.product" name="D'CASA: medidas y combo">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_price')]" position="after">
            <t t-set="dcasa_presentaciones" t-value="product._dcasa_presentaciones()"/>
            <t t-set="dcasa_promos_par" t-value="product._dcasa_promos_par()"/>
            <dl t-if="product.dcasa_medidas or product.dcasa_combo or dcasa_presentaciones or dcasa_promos_par"
                class="o_dcasa_ficha_datos mb-4">
                <!-- La promoción «2 por…» (models/precio_par.py): el texto sale del «Precio por par» del producto. -->
                <t t-if="dcasa_promos_par">
                    <dt>Promoción</dt>
                    <dd t-foreach="dcasa_promos_par" t-as="promocion" class="o_dcasa_promo_par" t-out="promocion"/>
                </t>
                <t t-if="product.dcasa_medidas">
                    <dt>Medidas</dt>
                    <dd t-out="product.dcasa_medidas"/>
                </t>
                <t t-if="dcasa_presentaciones">
                    <dt>Presentación</dt>
                    <dd t-foreach="dcasa_presentaciones" t-as="presentacion" class="o_dcasa_presentacion"
                        t-out="presentacion[1]"/>
                </t>
                <t t-if="product.dcasa_combo">
                    <dt>También en combo</dt>
                    <dd><span t-out="product.dcasa_combo"/>. Pídelo por WhatsApp.</dd>
                </t>
            </dl>
        </xpath>
    </template>

    <!-- La promoción por pares en el carrito, en el resumen del pago y en la página del cliente: la línea del par dice
         «Promoción: 2 cajas por $35.00» y la caja que sobra, «Caja suelta: precio normal» (models/precio_par.py). -->
    <template id="carrito_promo_par" inherit_id="website_sale.cart_line_description_following_lines"
              name="Baby Caleb: promoción por pares en el carrito">
        <xpath expr="//div[@t-if='description_lines']" position="after">
            <t t-set="dcasa_promo_par" t-value="line._dcasa_par_etiqueta()"/>
            <p t-if="dcasa_promo_par" class="o_dcasa_promo_par small mb-0" t-out="dcasa_promo_par"/>
        </xpath>
    </template>
    <template id="resumen_promo_par" inherit_id="website_sale.cart_summary_content"
              name="Baby Caleb: promoción por pares en el resumen">
        <xpath expr="//td[@name='website_sale_cart_summary_product_name']/span[1]" position="after">
            <t t-set="dcasa_promo_par" t-value="line._dcasa_par_etiqueta()"/>
            <p t-if="dcasa_promo_par" class="o_dcasa_promo_par small mb-0" t-out="dcasa_promo_par"/>
        </xpath>
    </template>
    <template id="portal_promo_par" inherit_id="sale.sale_order_portal_content"
              name="Baby Caleb: promoción por pares en la página del cliente">
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_name']" position="inside">
            <t t-set="dcasa_promo_par" t-value="line._dcasa_par_etiqueta()"/>
            <div t-if="dcasa_promo_par" class="small o_dcasa_promo_par" t-out="dcasa_promo_par"/>
        </xpath>
    </template>
</odoo>

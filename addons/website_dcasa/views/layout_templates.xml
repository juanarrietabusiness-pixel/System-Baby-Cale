                                    <li><a href="/visitanos">Horario y contacto</a></li>
                                </ul>
                            </nav>
                            <div class="o_dcasa_pie_columna">
                                <h2 class="o_dcasa_pie_titulo">Contacto</h2>
                                <ul class="list-unstyled">
                                    <li><a href="/whatsapp" target="_blank" rel="noopener nofollow">WhatsApp</a></li>

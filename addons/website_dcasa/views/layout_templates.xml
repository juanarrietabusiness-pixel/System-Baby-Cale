<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Botón flotante de WhatsApp en todo el sitio, con la forma de la burbuja del chat de babycaleb.com
         (src/components/Chatbot.tsx): un círculo naranja de 56 px con el ícono en navy (5.56 sobre el naranja). -->
    <template id="layout_whatsapp_float" inherit_id="website.layout" name="D'CASA: botón de WhatsApp"
              customize_show="True">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <!-- En carrito y checkout no: taparía el botón de confirmar (la página ya ofrece WhatsApp). -->
            <aside t-if="website and not request.httprequest.path.startswith(('/shop/cart', '/shop/checkout', '/shop/address', '/shop/payment', '/shop/confirm', '/shop/extra_info'))"
                   aria-label="WhatsApp">
                <a t-att-href="website._dcasa_whatsapp_url()" target="_blank" rel="noopener"
                   class="o_dcasa_wa_float" title="Escríbenos por WhatsApp">
                    <i class="fa fa-whatsapp" aria-hidden="true"/>
                    <span class="visually-hidden">Escríbenos por WhatsApp (se abre en una pestaña nueva)</span>
                </a>
            </aside>
        </xpath>
    </template>

    <!-- (La barra azul de anuncios de arriba, «Entrega a domicilio · Venta 100% online · Escríbenos por WhatsApp», se
         quitó con la marca de Baby Caleb, 2026-11-19: su cabecera es solo la pastilla de vidrio. Lo que decía sigue en la
         portada —la cobertura—, en el pie y en el botón flotante.) -->

    <!-- Cabecera sobre el hero: la portada (pageName) y las plantillas que piden
         `dcasa_header_overlay` (contacto, socios) llevan la misma clase que la opción de Odoo
         «Cabecera sobre el contenido». -->
    <template id="layout_cabecera_sobre_hero" inherit_id="website.layout" name="D'CASA: cabecera sobre el hero">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="#{'o_header_overlay' if dcasa_header_overlay or pageName == 'homepage' else ''}" separator=" "/>
        </xpath>
    </template>

    <!-- Fuente autoalojada (static/src/scss/fuentes.scss): fuera el preconnect a fonts.gstatic.com y precarga de
         Montserrat, la única letra del sitio (pinta el titular del hero, lo primero que se ve). -->
    <template id="layout_fuentes_locales" inherit_id="website.layout" name="D'CASA: fuentes locales">
        <xpath expr="//link[@rel='preconnect'][@href='https://fonts.gstatic.com/']" position="replace">
            <link rel="preload" href="/website_dcasa/static/src/fonts/montserrat-latin-var.woff2" as="font" type="font/woff2" crossorigin=""/>
        </xpath>
        <!-- Ronda 6: fuera la precarga de FontAwesome que pone Odoo (76 KB). En 4G lenta compartía
             la red con el CSS que bloquea el primer pintado y retrasaba la foto principal; los
             iconos llegan igual con el CSS, un instante después. -->
        <xpath expr="//link[@rel='preload'][contains(@href, 'fontawesome-webfont')]" position="replace"/>
    </template>

    <!-- Ícono al guardar el sitio, la tienda o el acceso del equipo (/web/login, /master) en la pantalla de inicio del
         celular: estrictamente el logo (pedido de la dueña, 2026-10-22; scripts/iconos_de_la_marca.py). Odoo usaba el
         favicon del sitio (un .ico), que el iPhone no acepta y reemplaza por una foto de la página. El iPhone toma
         apple-touch-icon (logo sobre blanco, sin transparencia); Android, el ícono más grande de la página. Sin
         manifiesto a propósito: el acceso directo abre la misma página que se guardó (/master sigue siendo /master). -->
    <template id="layout_icono_inicio" inherit_id="website.layout" name="D'CASA: ícono de la pantalla de inicio">
        <xpath expr="//link[@rel='apple-touch-icon']" position="replace">
            <link rel="apple-touch-icon" sizes="180x180" href="/dcasa_base/static/img/icono/apple-touch-icon.png"/>
            <link rel="icon" type="image/png" sizes="192x192" href="/dcasa_base/static/img/icono/logo-192.png"/>
            <link rel="icon" type="image/png" sizes="512x512" href="/dcasa_base/static/img/icono/logo-512.png"/>
        </xpath>
    </template>

    <!-- Foto de la portada (LCP) pedida desde el <head>, antes de que el CSS de Odoo (136 KB)
         termine de bajar: en 4G lenta llegaba ~0,6 s tarde. Si se cambia la foto del hero desde el
         editor, hay que quitar esta vista (Sitio web > Personalizar) o actualizar las rutas. -->
    <!-- Con el carrusel de la portada (models/portada.py) la imagen LCP es la foto de su primer producto (WebP del
         ancho justo, website_dcasa.hero_carrusel); sin carrusel, la foto de siempre. -->
    <template id="layout_precarga_hero" inherit_id="website.layout" name="D'CASA: precarga de la foto de la portada">
        <xpath expr="//head" position="inside">
            <t t-if="website and request and request.httprequest.path in ('/', website.homepage_url or '/')">
                <t t-set="dcasa_primera" t-value="(website._dcasa_hero_carrusel() or [None])[0]"/>
                <link t-if="dcasa_primera and dcasa_primera['srcset']" rel="preload" as="image" type="image/webp"
                      fetchpriority="high" t-att-imagesrcset="dcasa_primera['srcset']"
                      t-att-imagesizes="dcasa_primera['sizes']"/>
                <link t-elif="dcasa_primera" rel="preload" as="image" fetchpriority="high" t-att-href="dcasa_primera['src']"
                      t-att-imagesrcset="dcasa_primera['srcset_respaldo']" t-att-imagesizes="dcasa_primera['sizes']"/>
                <link t-else="" rel="preload" as="image" type="image/webp" fetchpriority="high"
                      href="/website_dcasa/static/src/img/hero-bebe-1200.webp"
                      imagesrcset="/website_dcasa/static/src/img/hero-bebe-800.webp 800w, /website_dcasa/static/src/img/hero-bebe-1200.webp 1200w"
                      imagesizes="(min-width: 992px) 46vw, 100vw"/>
            </t>
        </xpath>
    </template>

    <!-- Datos estructurados de la tienda (Google: ficha local y resultados enriquecidos). -->
    <template id="layout_json_ld" inherit_id="website.layout" name="D'CASA: datos estructurados">
        <xpath expr="//head" position="inside">
            <script t-if="website and request and request.httprequest.path in ('/', website.homepage_url or '/')" type="application/ld+json"
                    t-out="website._dcasa_json_ld()"/>
        </xpath>
    </template>

    <!-- JSON-LD «Organization» de website_sale (todas las páginas): el de Odoo escapa el nombre
         para HTML dentro del JSON («D&#39;CASA») y publica la URL local si no hay dominio. -->
    <template id="organizacion_json_ld" inherit_id="website_sale.website_sale_layout" name="D'CASA: organización (JSON-LD)">
        <xpath expr="//script[@t-if='res_company and website']" position="replace">
            <script t-if="res_company and website" type="application/ld+json"
                    t-out="website._dcasa_json_ld_organizacion(res_company)"/>
        </xpath>
    </template>

    <!-- Descripción para Google de la tienda (las categorías pueden tener la suya propia). -->
    <template id="products_meta_dcasa" inherit_id="website_sale.products" name="D'CASA: descripción de la tienda">
        <xpath expr="//t[@t-call='website.layout']" position="inside">
            <t t-set="website_meta_description">Catálogo de Baby Caleb: pañales Nateen hipoalergénicos, sin cloro, sin perfumes. Tallas RN a XXL en caja para todo el mes. Venta online con delivery en Ciudad de Panamá.</t>
            <!-- Sin categoría, Odoo titula la pestaña con el nombre de la vista («Products»). -->
            <t t-if="not category" t-set="additional_title">Catálogo</t>
        </xpath>
    </template>

    <!-- Nombre accesible de la barra de navegación: el de Odoo es «Main» / «Mobile», en inglés
         y sin traducción para el lector de pantalla. -->
    <template id="navbar_nombre_dcasa" inherit_id="website.navbar" name="D'CASA: nombre del menú en español">
        <xpath expr="//nav[@data-name='Navbar']" position="attributes">
            <attribute name="t-attf-aria-label">#{'Menú del celular' if _navbar_name == 'Mobile' else (_navbar_name or 'Menú principal')}</attribute>
        </xpath>
    </template>

    <!-- El menú del celular es un diálogo y tiene que portarse como uno (S01Nav.tsx de babycaleb.com: «el foco entra,
         da la vuelta dentro, sale con Escape y vuelve al botón que lo abrió»). El offcanvas de Bootstrap ya hace todo
         eso, pero solo si puede ponerle el foco al panel al abrirse: sin tabindex="-1" el foco se quedaba en la
         hamburguesa, DEBAJO del panel, y Escape no cerraba (su tecla la escucha el panel). Y los nombres, en español. -->
    <template id="menu_movil_accesible" inherit_id="website.template_header_mobile" name="D'CASA: menú del celular accesible">
        <xpath expr="//div[@id='top_menu_collapse_mobile']" position="attributes">
            <attribute name="tabindex">-1</attribute>
            <attribute name="aria-label">Menú de navegación</attribute>
        </xpath>
        <xpath expr="//button[@data-bs-target='#top_menu_collapse_mobile']" position="attributes">
            <attribute name="aria-label">Abrir menú</attribute>
        </xpath>
        <xpath expr="//div[@id='top_menu_collapse_mobile']//button[@data-bs-dismiss='offcanvas']" position="attributes">
            <attribute name="aria-label">Cerrar menú</attribute>
        </xpath>
    </template>

    <!-- Ficha de producto: WhatsApp con el nombre del producto y sellos de confianza junto al botón de compra. Baby Caleb
         (2026-11-18): la entrega a domicilio en Ciudad de Panamá y la atención personal de su web (content.json ›
         differentiators); fuera «te lo llevas hoy» y «míralo en tienda» (no tiene tienda). -->
    <template id="product_cta_dcasa" inherit_id="website_sale.cta_wrapper" name="D'CASA: confianza en la ficha">
        <!-- WhatsApp es el CTA de la marca: botón principal y antes de «Agregar al carrito». -->
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="before">
            <a t-if="website and product" t-att-href="website._dcasa_whatsapp_producto(product)" target="_blank" rel="noopener"
               class="btn btn-primary btn-lg w-100 mb-3 o_dcasa_wa_producto">
                <i class="fa fa-whatsapp me-2" aria-hidden="true"/>Pregunta por este producto por WhatsApp
            </a>
            <ul class="o_dcasa_sellos" role="list">
                <li><i class="fa fa-truck" aria-hidden="true"/><span><strong>Entrega a domicilio en Ciudad de Panamá.</strong> Costo y fecha por WhatsApp.</span></li>
                <li><i class="fa fa-comments" aria-hidden="true"/><span><strong>Atención personal.</strong> Asesoría directa y humana por WhatsApp — te ayudamos a elegir la talla, nada de formularios.</span></li>
            </ul>
        </xpath>
    </template>

    <!-- Filtro de refracción de la pastilla de vidrio: el mismo de babycaleb.com (#bc-liquido en su index.html). Lo
         aplica animaciones.js (en línea, con una variable CSS) solo donde backdrop-filter: url() funciona, y le agrega
         el movimiento lento del ruido (18 s), en pausa con la pestaña oculta y nunca con prefers-reduced-motion. -->
    <template id="layout_filtro_liquido" inherit_id="website.layout" name="D'CASA: filtro de vidrio líquido">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <svg class="o_dcasa_filtros" width="0" height="0" aria-hidden="true" focusable="false">
                <filter id="dcasa-liquido" x="-10%" y="-40%" width="120%" height="180%" color-interpolation-filters="sRGB">
                    <feTurbulence type="fractalNoise" baseFrequency="0.009 0.022" numOctaves="2" seed="7" result="ruido"/>
                    <feGaussianBlur in="ruido" stdDeviation="1.5" result="ruido_suave"/>
                    <feDisplacementMap in="SourceGraphic" in2="ruido_suave" scale="38"
                                       xChannelSelector="R" yChannelSelector="G"/>
                </filter>
            </svg>
        </xpath>
    </template>

    <!-- La marca de la pastilla, como la de babycaleb.com (src/blocks/S01Nav.tsx): solo el nombre «Baby Caleb» escrito,
         en Montserrat 700 navy, sin el sello (pedido del dueño, 2026-11-24: «tal cual»). En el editor sigue el campo del
         logo de Odoo, para que se pueda cambiar desde ahí. El nombre no se traduce ni se parte en dos líneas
         (translate="no" y nowrap en el CSS). -->
    <template id="logo_webp_dcasa" inherit_id="website.option_header_brand_logo" name="D'CASA: logo en WebP">
        <xpath expr="//span[@t-field='website.logo']" position="attributes">
            <attribute name="t-if">editable</attribute>
            <attribute name="t-att-aria-label">website.name</attribute>
        </xpath>
        <xpath expr="//span[@t-field='website.logo']" position="after">
            <span t-else="" class="o_dcasa_marca" translate="no" t-out="website.name"/>
        </xpath>
    </template>

    <!-- Botón de la cabecera: el CTA único del ADN en lugar de «Contáctanos». -->
    <!-- Sin «Escríbenos» en el menú (decisión de la dueña, 2026-11-15: «puede irse… ya está en el pie»). WhatsApp sigue en la
         franja de avisos de arriba, en la portada (foto grande y la sección de contacto), en las tarjetas, en el chat de
         Brian y en el pie. El enlace queda en la plantilla (las variantes de Odoo se apoyan en él) pero no se dibuja. -->
    <template id="header_cta_dcasa" inherit_id="website.header_call_to_action" name="D'CASA: WhatsApp en la cabecera">
        <xpath expr="//li" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//a[hasclass('btn_cta')]" position="replace">
            <a href="/whatsapp" target="_blank" rel="noopener nofollow" class="oe_unremovable btn btn-primary btn_cta"
               aria-label="Escríbenos por WhatsApp"><i class="fa fa-whatsapp me-2" aria-hidden="true"/>Escríbenos</a>
        </xpath>
    </template>

    <!-- Fuera «Con la tecnología de Odoo»: el sitio es de la empresa. Se quita el bloque del pie
         y se vacía la plantilla, así tampoco aparece en el portal ni en otras páginas. -->
    <template id="sin_credito_odoo" inherit_id="web.brand_promotion" name="D'CASA: sin crédito de Odoo">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace"/>
    </template>

    <template id="sin_credito_odoo_pie" inherit_id="website.layout" name="D'CASA: pie sin crédito de Odoo">
        <xpath expr="//t[@t-call='web.brand_promotion']/.." position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <!-- Páginas del programa de socios: la misma cabecera de página del resto del sitio (crema, el antetítulo en
         píldora y el titular navy; website_dcasa.cabecera_pagina). Sin foto: la de antes era de muebles. -->
    <template id="socios_cabecera_dcasa" inherit_id="dcasa_socios.socios_layout" name="D'CASA: cabecera de socios">
        <!-- Título de pestaña distinto por página y la pastilla de vidrio encima de la cabecera. -->
        <xpath expr="//t[@t-set='additional_title']" position="replace">
            <t t-set="additional_title" t-value="('%s · ' % titulo if titulo else '') + 'Socios Baby Caleb'"/>
            <t t-set="dcasa_header_overlay" t-value="True"/>
        </xpath>
        <xpath expr="//div[hasclass('o_dcasa_socios_head')]" position="replace">
            <section class="o_dcasa_hero o_dcasa_hero_compacto o_dcasa_cabecera_pagina o_dcasa_socios_head">
                <div class="o_dcasa_container o_dcasa_hero_inner">
                    <div class="o_dcasa_hero_texto" data-anim-entrada="">
                        <p class="o_dcasa_kicker o_dcasa_kicker_pildora">Programa de socios</p>
                        <h1 class="o_dcasa_display mb-0" t-out="titulo or 'Socios Baby Caleb'"/>
                    </div>
                </div>
            </section>
        </xpath>
        <xpath expr="//div[hasclass('o_dcasa_band')]" position="replace"/>
    </template>

    <!-- Cabecera de página para las que no traen la suya (legales, cuenta, contacto, socios): crema, como el hero de
         babycaleb.com, con el antetítulo en píldora y el titular navy en Montserrat 700, como frase. Quien la llama pone
         `dcasa_header_overlay` (la pastilla va encima), cabecera_kicker y cabecera_titulo. cabecera_imagen,
         cabecera_srcset, cabecera_ancho y cabecera_alto se siguen aceptando (dcasa_mi_cuenta los pasa) pero ya no se
         dibujan: las fotos de antes eran de muebles (marca de Baby Caleb, 2026-11-19). -->
    <template id="cabecera_pagina" name="D'CASA: cabecera de página">
        <section class="o_dcasa_hero o_dcasa_hero_compacto o_dcasa_cabecera_pagina">
            <div class="o_dcasa_container o_dcasa_hero_inner">
                <div class="o_dcasa_hero_texto" data-anim-entrada="">
                    <p class="o_dcasa_kicker o_dcasa_kicker_pildora" t-out="cabecera_kicker"/>
                    <h1 class="o_dcasa_display mb-0" t-out="cabecera_titulo"/>
                </div>
            </div>
        </section>
    </template>

    <!-- Entrar, crear cuenta y recuperar la clave: la misma cabecera de página que el resto del sitio y el
         formulario en una tarjeta crema (antes: formulario suelto bajo la píldora clara). -->
    <template id="login_cabecera_dcasa" inherit_id="website.login_layout" name="D'CASA: cabecera de la cuenta">
        <xpath expr="//div[hasclass('oe_website_login_container')]" position="before">
            <t t-set="dcasa_header_overlay" t-value="True"/>
            <t t-call="website_dcasa.cabecera_pagina">
                <t t-set="cabecera_kicker">Tu cuenta Baby Caleb</t>
                <t t-set="cabecera_titulo">Mi cuenta</t>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('oe_website_login_container')]" position="attributes">
            <attribute name="class" add="o_dcasa_login" separator=" "/>
            <!-- Destino del enlace «Saltar al contenido» (#wrap): en la cuenta no existía. -->
            <attribute name="id">wrap</attribute>
        </xpath>
    </template>

    <!-- Accesibilidad del formulario de entrar de Odoo (Lighthouse): el botón del ojo no tenía
         nombre y «Restablecer contraseña» llevaba tabindex="1" (rompe el orden del teclado). -->
    <template id="login_accesible_dcasa" inherit_id="web.login" name="D'CASA: entrar accesible">
        <xpath expr="//button[hasclass('o_show_password')]" position="attributes">
            <attribute name="aria-label">Mostrar u ocultar la contraseña</attribute>
            <attribute name="title">Mostrar u ocultar la contraseña</attribute>
        </xpath>
    </template>

    <!-- Ficha: la cantidad no tenía nombre para el lector de pantalla (Lighthouse «label»). -->
    <template id="ficha_cantidad_accesible_dcasa" inherit_id="website_sale.product_quantity" name="D'CASA: cantidad con nombre">
        <xpath expr="//input[@name='add_qty']" position="attributes">
            <attribute name="aria-label">Cantidad</attribute>
            <attribute name="inputmode">numeric</attribute>
        </xpath>
    </template>

    <template id="login_orden_teclado_dcasa" inherit_id="auth_signup.login" name="D'CASA: orden del teclado al entrar">
        <xpath expr="//a[@tabindex='1']" position="attributes">
            <attribute name="tabindex"/>
        </xpath>
    </template>

    <!-- El copyright de babycaleb.com (S20Footer.tsx: «© Baby Caleb Panamá. Todos los derechos reservados.», con
         content.json › legal › company). Sin el año: esta zona la guarda el editor del sitio como texto fijo. -->
    <template id="footer_copyright_dcasa" inherit_id="website.footer_copyright_company_name" name="D'CASA: copyright">
        <xpath expr="//span[hasclass('o_footer_copyright_name')]" position="replace">
            <span class="o_footer_copyright_name me-2 small">© <span translate="no">Baby Caleb Panamá</span>. Todos los derechos reservados.</span>
        </xpath>
    </template>

    <!-- «Promociones» en el menú solo mientras la campaña está activa (pregunta de la dueña, 2026-11-15: «¿es necesario
         un botón en el navbar que diga inicio? o promociones?»; eligió el enlace sencillo, igual a los demás). Lleva a
         /promociones; se enciende y se apaga con las fechas de la campaña (Sitio web › Campaña del sitio), así que
         fuera de campaña el menú queda igual. -->
    <template id="menu_promociones" inherit_id="website.navbar_nav" name="D'CASA: Promociones en el menú">
        <xpath expr="//t[@t-out='0']" position="after">
            <li t-if="website and website._dcasa_black_weekend_activo()"
                t-attf-class="nav-item #{is_mobile and 'border-top border-bottom' or ''}" role="presentation">
                <a href="/promociones" role="menuitem"
                   t-attf-class="nav-link o_dcasa_menu_promo #{request and request.httprequest.path == '/promociones' and 'active' or ''}">
                    <span>Promociones</span>
                </a>
            </li>
        </xpath>
    </template>

    <!-- Pie de página como el de babycaleb.com (src/blocks/S20Footer.tsx): crema, con la marca, el lema, la cobertura, los
         enlaces, el contacto y los legales. Los datos son los de su web (content.json, decisión del dueño del 2026-11-18).
         Sin RUC: el dueño todavía no lo dio, y no se inventa. Sin dirección: vende 100% en línea. Editable en el
         constructor; nada dinámico aquí dentro: al guardar, el editor escribe en la vista el HTML ya dibujado de esta
         zona (ir.ui.view.save) y un t-out quedaría como texto fijo. Lo dinámico va fuera, como el horario (pie_horario).
         Lo que heredan otros módulos y no se puede mover: el enlace a /my (dcasa_mi_cuenta lo cambia a /mi-cuenta) y el
         <li> de /terminos (dcasa_meta_eventos pone «Preferencias de cookies» después). -->
    <template id="footer_dcasa" inherit_id="website.footer_custom" name="D'CASA: pie de página">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo o_dcasa_footer" t-ignore="true" t-if="not no_footer">
                <section class="s_text_block o_dcasa_pie" data-snippet="s_text_block" data-name="Pie de página">
                    <div class="container">
                        <div class="o_dcasa_pie_rejilla">
                            <div class="o_dcasa_pie_marca">
                                <p class="o_dcasa_pie_nombre" translate="no">Baby Caleb</p>
                                <p class="o_dcasa_pie_lema">Esenciales de bebé hipoalergénicos y biodegradables — pensamos en cada etapa de tu bebé.</p>
                                <p class="o_dcasa_pie_cobertura">Venta 100% online con entrega a domicilio en Ciudad de Panamá.</p>
                            </div>
                            <!-- Los enlaces de su pie (S20Footer.tsx), los mismos del menú. -->
                            <nav class="o_dcasa_pie_columna" aria-labelledby="dcasa-pie-enlaces">
                                <h2 id="dcasa-pie-enlaces" class="o_dcasa_pie_titulo">Enlaces</h2>
                                <ul class="list-unstyled">
                                    <li><a href="/shop">Productos</a></li>
                                    <li><a href="/beneficios">Beneficios</a></li>
                                    <li><a href="/historia">Historia</a></li>
                                    <li><a href="/tips">Tips</a></li>
                                    <li><a href="/como-comprar">Cómo comprar</a></li>
                                    <li><a href="/faq">FAQ</a></li>
                                </ul>
                            </nav>
                            <!-- Lo que este sistema tiene y su web no: la cuenta del cliente, los puntos y el contacto. -->
                            <nav class="o_dcasa_pie_columna" aria-labelledby="dcasa-pie-cuenta">

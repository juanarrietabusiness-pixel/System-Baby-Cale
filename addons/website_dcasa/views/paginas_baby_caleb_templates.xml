    <!-- La banda verde final (S19CTA.tsx), con su frase y «Ver el catálogo». -->
    <template id="seccion_cta_final" name="Baby Caleb: banda final">
        <section class="o_dcasa_cta_final" aria-labelledby="dcasa-cta-final-titulo">
            <div class="o_dcasa_container o_dcasa_cta_final_inner" data-anim-cascada="">
                <h2 id="dcasa-cta-final-titulo" class="o_dcasa_cta_final_titulo">Dale a tu bebé el cuidado que su piel merece.</h2>
                <div><a href="/shop" class="btn btn-primary btn-lg o_dcasa_btn_hero">Ver el catálogo</a></div>
            </div>
        </section>
    </template>

    <!-- Por qué Baby Caleb (S08Differentiators.tsx · content.json › differentiators). El cuarto dice «haces tu pedido en
         la página» donde su web dice «pagas en la página»: aquí el pago se elige al pedir y el envío se cotiza. -->
    <template id="seccion_diferenciadores" name="Baby Caleb: por qué Baby Caleb">
        <section class="o_dcasa_section o_dcasa_diferenciadores" aria-labelledby="dcasa-diferenciadores-titulo">
            <div class="o_dcasa_container">
                <div class="o_dcasa_section_head">
                    <div>
                        <p class="o_dcasa_kicker">Por qué Baby Caleb</p>
                        <h2 id="dcasa-diferenciadores-titulo" class="o_dcasa_h2" data-titular="">Más allá de un pañal, un servicio pensado para ti.</h2>
                    </div>
                </div>
                <ol class="o_dcasa_diferenciadores_lista" role="list" data-anim-cascada="">
                    <li class="o_dcasa_diferenciador">
                        <span class="o_dcasa_diferenciador_numero" aria-hidden="true">01</span>
                        <h3>Cajas para todo el mes</h3>
                        <p>Vendemos en caja grande, no por paquete suelto: te sale más accesible y no te quedas sin pañales a mitad de mes.</p>
                    </li>
                    <li class="o_dcasa_diferenciador">
                        <span class="o_dcasa_diferenciador_numero" aria-hidden="true">02</span>
                        <h3>De recién nacido a XXL</h3>
                        <p>Cubrimos desde recién nacidos y prematuros (talla RN, desde 4 libras) hasta niños de más de 55 libras — la talla XXL es difícil de conseguir en Panamá.</p>
                    </li>
                    <li class="o_dcasa_diferenciador">
                        <span class="o_dcasa_diferenciador_numero" aria-hidden="true">03</span>
                        <h3>Atención personal</h3>
                        <p>Asesoría directa y humana por WhatsApp — te ayudamos a elegir la talla, nada de formularios.</p>
                    </li>
                    <li class="o_dcasa_diferenciador">
                        <span class="o_dcasa_diferenciador_numero" aria-hidden="true">04</span>
                        <h3>Delivery a domicilio</h3>
                        <p>Vendemos 100% online: eliges, haces tu pedido en la página y te lo llevamos a domicilio en Ciudad de Panamá.</p>
                    </li>
                </ol>
            </div>
        </section>
    </template>

    <!-- Nuestra historia (S12Historia.tsx · content.json › about), con la cita y las tres cifras de su web: son de la
         dueña, publicadas en babycaleb.com, no se inventan aquí. -->
    <template id="seccion_historia" name="Baby Caleb: nuestra historia">
        <section class="o_dcasa_section o_dcasa_historia" aria-labelledby="dcasa-historia-titulo">
            <div class="o_dcasa_container o_dcasa_historia_grid">
                <div class="o_dcasa_historia_texto" data-anim-cascada="">
                    <div>
                        <p class="o_dcasa_kicker">Nuestra historia</p>
                        <h2 id="dcasa-historia-titulo" class="o_dcasa_h2">Cuidamos a los que más amas</h2>
                    </div>
                    <p class="o_dcasa_lead">Baby Caleb nació en 2024 en Panamá con una idea simple: que conseguir pañales y wipes verdaderamente hipoalergénicos no tenga que ser una odisea. Trabajamos con marcas de buena reputación —pañales y wipes Nateen, wipes de agua Dany Baby y fulares Moon— y vendemos en cajas que te alcanzan para todo el mes, con atención personal por WhatsApp y entrega a domicilio en Ciudad de Panamá.</p>
                    <blockquote class="o_dcasa_historia_cita"><p>«En Baby Caleb Panamá pensamos en cada etapa de tu bebé.»</p></blockquote>
                    <dl class="o_dcasa_historia_cifras">
                        <div><dt>6</dt><dd>tallas, de RN a XXL</dd></div>
                        <div><dt>2024</dt><dd>cuidando bebés en Panamá</dd></div>
                        <div><dt>100%</dt><dd>online con delivery</dd></div>
                    </dl>
                </div>
                <div class="o_dcasa_historia_visual">
                    <div class="o_dcasa_historia_foto">
                        <img src="/website_dcasa/static/src/img/promo-nateen-1200.webp"
                             srcset="/website_dcasa/static/src/img/promo-nateen-800.webp 800w, /website_dcasa/static/src/img/promo-nateen-1200.webp 1200w"
                             sizes="(min-width: 768px) 45vw, 100vw" width="1200" height="850" loading="lazy" decoding="async"
                             alt="Familia Nateen — línea completa de pañales hipoalergénicos"/>
                    </div>
                    <img class="o_dcasa_historia_sello" src="/website_dcasa/static/src/img/sello-badge-224.webp"
                         width="112" height="112" loading="lazy" decoding="async" alt="Baby Caleb"/>
                </div>
            </div>
        </section>
    </template>

    <!-- Tips (S13Tips.tsx · content.json › tips): las seis lecturas con su foto. Su web cierra mandando al asistente del
         chat; aquí el canal seguro es WhatsApp (el chat de la tienda depende de las llaves de Juan), así que el cierre
         lleva ahí. -->
    <template id="seccion_tips" name="Baby Caleb: tips">
        <section class="o_dcasa_section o_dcasa_tips" aria-labelledby="dcasa-tips-titulo">
            <div class="o_dcasa_container">
                <div class="o_dcasa_section_head">
                    <div>
                        <p class="o_dcasa_kicker">Tips y educación</p>
                        <h2 id="dcasa-tips-titulo" class="o_dcasa_h2" data-titular="">Cuidar la piel de tu bebé, mejor informada.</h2>
                        <p class="o_dcasa_lead o_dcasa_section_descripcion">Lo que aprendimos vendiendo pañales hipoalergénicos, resumido en 6 lecturas breves.</p>
                    </div>
                </div>
                <t t-set="dcasa_tips" t-value="[
                    ('tip-panalitis', 'Tips para evitar la pañalitis', 'Cambios frecuentes, secado correcto y pañales transpirables: hábitos pequeños que evitan grandes irritaciones.'),
                    ('tip-cloro', 'Pañal «libre de cloro» vs «sin cloro»', 'No es lo mismo. Te explicamos qué hay detrás de cada etiqueta para que no te la vendan con cuento.'),
                    ('tip-senales-piel', 'La piel avisa antes de quejarse', '3 señales de que tu pañal actual podría estar irritando a tu bebé, y qué hacer antes de que empeore.'),
                    ('tip-quien-se-beneficia', '¿Quién se beneficia más de un pañal hipoalergénico?', 'Recién nacidos, prematuros, piel sensible o historial familiar de alergias — quién debería probar el cambio.'),
                    ('tip-wipes-caja', '¿Por qué comprar la caja de wipes?', 'Más toallitas por caja, menor costo por unidad y te alcanza para todo el mes.'),
                    ('tip-pediatra', 'Cuándo consultar al pediatra', 'Irritación de más de 3 días, ampollas o fiebre: cuándo lo del pañal ya no es cosa del pañal.'),
                ]"/>
                <ul class="o_dcasa_tips_lista" role="list" data-anim-cascada="">
                    <li t-foreach="dcasa_tips" t-as="tip">
                        <article class="o_dcasa_tip">
                            <div class="o_dcasa_tip_foto">
                                <img t-att-src="'/website_dcasa/static/src/img/%s-720.webp' % tip[0]"
                                     t-att-srcset="'/website_dcasa/static/src/img/%s-480.webp 480w, /website_dcasa/static/src/img/%s-720.webp 720w' % (tip[0], tip[0])"
                                     sizes="(min-width: 992px) 30vw, (min-width: 576px) 46vw, 100vw"
                                     width="720" height="900" t-att-loading="'eager' if tip_index &lt; 3 else 'lazy'" decoding="async"
                                     t-att-alt="tip[1]"/>
                            </div>
                            <div class="o_dcasa_tip_cuerpo">
                                <p class="o_dcasa_tip_numero">Tip <t t-out="'%02d' % (tip_index + 1)"/></p>
                                <h3 t-out="tip[1]"/>
                                <p t-out="tip[2]"/>
                            </div>
                        </article>
                    </li>
                </ul>
                <p class="o_dcasa_tips_cierre">¿Tienes una duda que no está aquí?
                    <a class="o_dcasa_link" href="/whatsapp" target="_blank" rel="noopener">Escríbenos por WhatsApp<span class="visually-hidden"> (se abre en una pestaña nueva)</span></a>
                </p>
            </div>
        </section>
    </template>

    <!-- Cómo comprar (S16HowToBuy.tsx · content.json › howToBuy). Los pasos 02 y 03 dicen lo que este sistema hace: el
         pago se elige al pedir (Yappy o transferencia) y el costo del envío se confirma por WhatsApp antes de cobrar.
         Su web dice «paga con Yappy en la misma página» y «eliges tu zona al pagar». -->
    <template id="seccion_como_comprar" name="Baby Caleb: cómo comprar">
        <section class="o_dcasa_section o_dcasa_como_comprar" aria-labelledby="dcasa-como-comprar-titulo">
            <div class="o_dcasa_container o_dcasa_como_comprar_grid">
                <div>
                    <p class="o_dcasa_kicker">Cómo comprar</p>
                    <h2 id="dcasa-como-comprar-titulo" class="o_dcasa_h2" data-titular="">Simple, directo y sin complicaciones.</h2>
                    <p class="o_dcasa_lead o_dcasa_section_descripcion">Hacer tu pedido es tan fácil como enviar un mensaje. Nosotros nos encargamos del resto.</p>
                </div>
                <ol class="o_dcasa_pasos" role="list" data-anim-cascada="">
                    <li class="o_dcasa_paso">
                        <p class="o_dcasa_paso_numero">Paso 01</p>
                        <h3>Elige</h3>
                        <p>Entra al catálogo y elige tu producto, tu presentación y tu talla. Si dudas con la talla, escríbenos por WhatsApp y te ayudamos.</p>
                    </li>
                    <li class="o_dcasa_paso">
                        <p class="o_dcasa_paso_numero">Paso 02</p>
                        <h3>Pide</h3>
                        <p>Agrégalo al carrito y haz tu pedido aquí mismo: eliges si pagas con Yappy o por transferencia. El costo del envío te lo confirmamos por WhatsApp antes de cobrar.</p>
                    </li>
                    <li class="o_dcasa_paso">
                        <p class="o_dcasa_paso_numero">Paso 03</p>
                        <h3>Recibe</h3>
                        <p>Te lo llevamos a domicilio en Ciudad de Panamá, en la fecha que coordinamos contigo.</p>
                    </li>
                </ol>
            </div>
        </section>
    </template>

    <!-- Preguntas frecuentes (S14FAQ.tsx · content.json › faq). <details> en lugar de su acordeón de React: se abre y se
         cierra con el teclado y sin JavaScript, y el lector de pantalla anuncia si está abierta. Dos respuestas dicen lo
         que este sistema hace (la de la tienda física y la del delivery); el resto, tal cual. -->
    <template id="seccion_preguntas" name="Baby Caleb: preguntas frecuentes">
        <t t-set="dcasa_preguntas" t-value="website._dcasa_preguntas()"/>
        <section class="o_dcasa_section o_dcasa_preguntas" aria-labelledby="dcasa-preguntas-titulo">
            <div class="o_dcasa_container">
                <div class="o_dcasa_section_head o_dcasa_section_head_centro">
                    <div>
                        <p class="o_dcasa_kicker">Preguntas frecuentes</p>
                        <h2 id="dcasa-preguntas-titulo" class="o_dcasa_h2" data-titular="">Resolvemos tus dudas.</h2>
                    </div>
                </div>
                <div class="o_dcasa_preguntas_lista" data-anim-cascada="">
                    <details t-foreach="dcasa_preguntas" t-as="pregunta" class="o_dcasa_pregunta">
                        <summary>
                            <span t-out="pregunta[0]"/>
                            <svg class="o_dcasa_pregunta_flecha" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        </summary>
                        <p t-out="pregunta[1]"/>
                    </details>
                </div>
            </div>
        </section>
        <!-- Para Google: las mismas preguntas como FAQPage (src/pages/FAQ.tsx). Solo en /faq, que es la página de las
             preguntas (dcasa_faq_json_ld). -->
        <script t-if="dcasa_faq_json_ld" type="application/ld+json" t-out="website._dcasa_faq_json_ld()"/>
    </template>

    <!-- ==================================================================================================== -->
    <!-- Páginas (src/pages/*.tsx), con el título y la descripción de su web (src/seo/rutas.ts)              -->
    <!-- ==================================================================================================== -->

    <!-- El esqueleto común: la cabecera flota encima (como en todas las de su web), el titular de la página es solo para
         el lector de pantalla y los buscadores (su web hace lo mismo: <h1 className="sr-only">) y cierra la banda final. -->
    <template id="pagina_baby_caleb" name="Baby Caleb: página">
        <t t-call="website.layout">
            <t t-set="dcasa_header_overlay" t-value="True"/>
            <div id="wrap" t-attf-class="o_dcasa_pagina_bc o_dcasa_pagina_#{dcasa_pagina}">
                <h1 class="visually-hidden" t-out="dcasa_h1"/>
                <t t-out="0"/>
                <t t-call="website_dcasa.seccion_cta_final"/>
            </div>
        </t>
    </template>

    <template id="pagina_beneficios" name="Beneficios">
        <t t-call="website_dcasa.pagina_baby_caleb">
            <t t-set="pageName" t-value="'beneficios'"/>
            <t t-set="dcasa_pagina" t-value="'beneficios'"/>
            <t t-set="title">Beneficios | Pañales hipoalergénicos Nateen — Baby Caleb Panamá</t>
            <t t-set="website_meta_description">Cajas para todo el mes, tallas de RN a XXL, atención personal por WhatsApp y delivery a domicilio. Descubre por qué las familias eligen Baby Caleb.</t>
            <t t-set="dcasa_h1">Beneficios de los pañales hipoalergénicos Nateen</t>
            <t t-call="website_dcasa.seccion_diferenciadores"/>
            <t t-call="website_dcasa.seccion_testimonios"/>
        </t>
    </template>

    <template id="pagina_historia" name="Historia">
        <t t-call="website_dcasa.pagina_baby_caleb">
            <t t-set="pageName" t-value="'historia'"/>
            <t t-set="dcasa_pagina" t-value="'historia'"/>
            <t t-set="title">Nuestra historia | Baby Caleb Panamá</t>
            <t t-set="website_meta_description">Baby Caleb nació en 2024 en Panamá para que conseguir pañales y wipes hipoalergénicos deje de ser una odisea. Marcas de confianza, cajas para todo el mes y delivery.</t>
            <t t-set="dcasa_h1">Nuestra historia</t>
            <t t-call="website_dcasa.seccion_historia"/>
            <t t-call="website_dcasa.seccion_sellos"/>
            <t t-call="website_dcasa.seccion_educacion"/>
        </t>
    </template>

    <template id="pagina_tips" name="Tips">
        <t t-call="website_dcasa.pagina_baby_caleb">
            <t t-set="pageName" t-value="'tips'"/>
            <t t-set="dcasa_pagina" t-value="'tips'"/>
            <t t-set="title">Tips y cuidado de la piel del bebé | Baby Caleb Panamá</t>
            <t t-set="website_meta_description">Consejos prácticos para evitar la pañalitis, entender qué significa «sin cloro» y reconocer señales de irritación en la piel de tu bebé.</t>
            <t t-set="dcasa_h1">Tips para cuidar la piel de tu bebé</t>
            <t t-call="website_dcasa.seccion_tips"/>
            <t t-call="website_dcasa.seccion_educacion"/>
        </t>
    </template>

    <!-- «Haz tu pedido por WhatsApp en 3 pasos» de su descripción pasa a «en 3 pasos»: aquí el pedido se hace en la
         página y WhatsApp es para la talla y el envío. -->
    <template id="pagina_como_comprar" name="Cómo comprar">

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Las páginas de babycaleb.com (src/pages/*.tsx) y las secciones con que se arman (src/blocks/*.tsx), pedidas
         «tal cual» por el dueño el 2026-11-24. Los textos son los de su web (content.json); solo cambia lo que este
         sistema hace distinto, y cada cambio lo dice su comentario. El pago no es «con Yappy en la misma página»: se
         elige Yappy o transferencia al hacer el pedido, y el envío se cotiza por WhatsApp.

         La portada (homepage_templates.xml) usa las mismas secciones: un texto se corrige en un solo lugar. -->

    <!-- ==================================================================================================== -->
    <!-- Secciones                                                                                            -->
    <!-- ==================================================================================================== -->

    <!-- Los cuatro sellos (S04Trust.tsx · content.json › trust), con los íconos de lucide de su web (leaf,
         droplet-off, recycle, heart; licencia ISC) en un círculo crema. Lleva la clase o_dcasa_beneficios de siempre:
         la reconoce Brian de la tienda (dcasa_brian_tienda). -->
    <template id="seccion_sellos" name="Baby Caleb: los cuatro sellos">
        <section class="o_dcasa_beneficios o_dcasa_confianza" aria-label="Lo que distingue a nuestros productos">
            <div class="o_dcasa_container">
                <ul class="o_dcasa_confianza_lista" role="list" data-anim-cascada="">
                    <li>
                        <span class="o_dcasa_confianza_icono" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg></span>
                        <span class="o_dcasa_confianza_texto">Hipoalergénico</span>
                    </li>
                    <li>
                        <span class="o_dcasa_confianza_icono" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M18.715 13.186C18.29 11.858 17.384 10.607 16 9.5c-2-1.6-3.5-4-4-6.5a10.7 10.7 0 0 1-.884 2.586"/><path d="m2 2 20 20"/><path d="M8.795 8.797A11 11 0 0 1 8 9.5C6 11.1 5 13 5 15a7 7 0 0 0 13.222 3.208"/></svg></span>
                        <span class="o_dcasa_confianza_texto">Sin cloro</span>
                    </li>
                    <li>
                        <span class="o_dcasa_confianza_icono" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5"/><path d="M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12"/><path d="m14 16-3 3 3 3"/><path d="M8.293 13.596 7.196 9.5 3.1 10.598"/><path d="m9.344 5.811 1.093-1.892A1.83 1.83 0 0 1 11.985 3a1.784 1.784 0 0 1 1.546.888l3.943 6.843"/><path d="m13.378 9.633 4.096 1.098 1.097-4.096"/></svg></span>
                        <span class="o_dcasa_confianza_texto">Biodegradable</span>
                    </li>
                    <li>
                        <span class="o_dcasa_confianza_icono" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></span>
                        <span class="o_dcasa_confianza_texto">Piel sensible</span>
                    </li>
                </ul>
            </div>
        </section>
    </template>

    <!-- La banda verde de educación (S03Education.tsx · content.json › education), tal cual. -->
    <template id="seccion_educacion" name="Baby Caleb: ¿Sabías que…?">
        <section class="o_dcasa_educacion">
            <div class="o_dcasa_container o_dcasa_educacion_inner">
                <h2 class="o_dcasa_educacion_pregunta" data-titular="">¿Sabías que no es lo mismo 'libre de cloro' que 'sin cloro'?</h2>
                <p class="o_dcasa_educacion_respuesta" data-anim="">Muchos pañales del mercado son ECF (Elemental Chlorine Free): no usan cloro puro, pero sí derivados del cloro para blanquear la pulpa. Nuestros pañales Nateen se fabrican sin cloro ni perfumes, con 100% fibras de bambú. Pregunta siempre qué lleva el pañal de tu bebé: #QUENOTENEGAÑEN.</p>
            </div>
        </section>
    </template>

    <!-- Lo que dicen las mamás (S11Testimonials.tsx · content.json › testimonials): de la dueña, publicados en su web,
         copiados tal cual (nombre, papel, cita y resultado). -->
    <template id="seccion_testimonios" name="Baby Caleb: lo que dicen las mamás">
        <section class="o_dcasa_section o_dcasa_testimonios" aria-labelledby="dcasa-testimonios-titulo">
            <div class="o_dcasa_container">
                <div class="o_dcasa_section_head o_dcasa_section_head_centro">
                    <div>
